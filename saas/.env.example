# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and keys from Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only service-role key (never expose to the client):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── WhatChimp (defaults; per-salon overrides live in the salons table) ──────
WHATCHIMP_API_TOKEN=your_whatchimp_api_key
WHATCHIMP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATCHIMP_TEMPLATE_NAME=booking_confirmation
WHATCHIMP_LANGUAGE_CODE=en_US
WHATCHIMP_DEFAULT_COUNTRY_CODE=44
