# ─── IMAP Mailbox Configuration ─────────────────────────────────────────────
# Connection details for the email inbox where booking emails arrive.
# The bridge listens for new emails and forwards parsed data to Zapier.

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password_or_token
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL=30

# ─── Zapier Webhook ─────────────────────────────────────────────────────────
# Your Zapier webhook URL that receives parsed appointment data.
# Zapier triggers WhatsApp message flows from this data.

ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-webhook-id