# ─── Email Filter Configuration ────────────────────────────────────────────
# Filter criteria for detecting booking emails from Ovatu.
# Emails matching these criteria will be parsed and forwarded to Zapier.

EMAIL_FILTER_SENDER=reservations@ovatu.com
EMAIL_FILTER_SUBJECT=thankyou for your booking at the

# ─── Zapier Webhook ─────────────────────────────────────────────────────────
# Your Zapier webhook URL that receives parsed appointment data.
# Zapier triggers WhatsApp message flows from this data.

ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-webhook-id

# ─── Agent Polling (optional) ──────────────────────────────────────────────
# Time between polling cycles when using the agent-based inbox checker.
# Not used by the standalone bridge — used by the agent running inbox-agent.js.

POLL_INTERVAL_SECONDS=60