# ─── Database (provider-agnostic) ───────────────────────────────────────────
# Single connection string. Works with Supabase Postgres, Neon, or any Postgres.
#   Supabase: Project Settings → Database → Connection string → URI (or Pooler)
#   Neon:     Neon console → Connection Details → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ─── Supabase Auth (optional — client-side only) ─────────────────────────────
# Only needed if you use Supabase Auth for login/signup. The data layer above
# does NOT depend on these.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── WhatChimp (Coexistence / Multi-Device) ─────────────────────────────────
# SalonStream holds ONE WhatChimp account. The API token is shared by every
# salon and lives only in the backend. Each salon connects its OWN WhatsApp
# Business number via the Coexistence QR-code flow; the resulting per-salon
# device/instance id is stored on the salon row (whatchimp_instance_id) and
# passed as `phone_number_id` on send.
WHATCHIMP_API_TOKEN=your_whatchimp_api_key
WHATCHIMP_TEMPLATE_NAME=booking_confirmation
WHATCHIMP_LANGUAGE_CODE=en_US
WHATCHIMP_DEFAULT_COUNTRY_CODE=44
# Public URL of WhatChimp's Coexistence connection page (opened when the owner
# clicks "Connect WhatsApp" during onboarding). Optional — has a default.
NEXT_PUBLIC_WHATCHIMP_CONNECT_URL=https://app.whatchimp.com/whatsapp/bot/connect

# ─── Stripe (subscription billing via Stripe Checkout) ───────────────────────
# Secret key from Stripe Dashboard → Developers → API keys. Keep server-side.
STRIPE_SECRET_KEY=sk_live_...
# Signing secret for the /api/webhooks/stripe endpoint (Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_...
# Public origin of the app, used to build the Checkout success/cancel URLs.
# Optional in most deployments (the app derives it from the request headers),
# but set it explicitly if you sit behind a proxy that rewrites host headers.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# ─── Forwarding email ────────────────────────────────────────────────────────
# Domain used for each salon's unique inbound email address (<slug>@domain).
# Optional — defaults to salonstream.app.
NEXT_PUBLIC_FORWARDING_EMAIL_DOMAIN=salonstream.app