# ─── Email Filter Configuration ────────────────────────────────────────────
# Filter criteria for detecting booking emails from Ovatu.
# Emails matching these criteria will be parsed and forwarded to Zapier.

EMAIL_FILTER_SENDER=reservations@ovatu.com
EMAIL_FILTER_SUBJECT=thankyou for your booking at the

# ─── Zapier Webhook (legacy fallback) ────────────────────────────────────────
# Your Zapier webhook URL that receives parsed appointment data.
# Zapier triggers WhatsApp message flows from this data.
# NOTE: Direct WhatChimp messaging (below) is preferred and removes Zapier cost.

ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-webhook-id

# ─── WhatChimp Direct WhatsApp (recommended) ─────────────────────────────────
# Sends WhatsApp messages straight from parsed bookings — no Zapier needed.
# Get these from the WhatChimp API Developer Console (app.whatchimp.com).
# Docs: https://help.whatchimp.com/docs/whatchimp-apis

WHATCHIMP_API_TOKEN=your_whatchimp_api_key
WHATCHIMP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Optional: approved template name for booking messages. Template messages
# work anytime; free-form text only works within WhatsApp's 24h session window.
# Leave blank to send a free-form text message instead.
WHATCHIMP_TEMPLATE_NAME=

# Optional: template language code (default en_US)
WHATCHIMP_LANGUAGE_CODE=en_US

# Optional: country code assumed for local numbers (e.g. 07700... -> 447700...)
WHATCHIMP_DEFAULT_COUNTRY_CODE=44

# ─── Agent Polling (optional) ──────────────────────────────────────────────
# Time between polling cycles when using the agent-based inbox checker.
# Not used by the standalone bridge — used by the agent running inbox-agent.js.

POLL_INTERVAL_SECONDS=60